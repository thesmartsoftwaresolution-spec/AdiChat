{
  "id": "/",
  "name": "AdiChat — Realtime Chat & AI Assistants",
  "short_name": "AdiChat",
  "description": "Private messaging, group conversations and personal AI assistants.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#fcf8f8",
  "theme_color": "#004327",
  "categories": [
    "communication",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/adichat-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/adichat-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/adichat.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false
}
